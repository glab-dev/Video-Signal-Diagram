{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project Setup & Dev Server",
      "type": "shell",
      "command": "git pull origin main && npm install && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> ",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "name": "Dev Server"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
